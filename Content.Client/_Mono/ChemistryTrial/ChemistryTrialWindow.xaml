<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'chemistry-trial-window-title'}"
                      SetSize="620 560"
                      MinSize="520 460">
    <BoxContainer Orientation="Vertical" Margin="10">

        <!-- Configuration -->
        <BoxContainer Name="ConfigBox" Orientation="Vertical" VerticalExpand="True">
            <Label Text="{Loc 'chemistry-trial-duration'}" StyleClasses="LabelKeyText"/>
            <BoxContainer Orientation="Horizontal" Margin="0 4 0 8">
                <SpinBox Name="MinutesSpin" MinWidth="130"/>
                <Label Text="{Loc 'chemistry-trial-minutes'}" Margin="6 0 16 0"/>
                <SpinBox Name="SecondsSpin" MinWidth="130"/>
                <Label Text="{Loc 'chemistry-trial-seconds'}" Margin="6 0 0 0"/>
            </BoxContainer>

            <Label Text="{Loc 'chemistry-trial-reveal-duration'}" StyleClasses="LabelKeyText"/>
            <BoxContainer Orientation="Horizontal" Margin="0 4 0 8">
                <SpinBox Name="RevealSpin" MinWidth="130"/>
                <Label Text="{Loc 'chemistry-trial-seconds'}" Margin="6 0 0 0"/>
            </BoxContainer>

            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'chemistry-trial-categories'}" StyleClasses="LabelKeyText" HorizontalExpand="True"/>
                <Button Name="AllButton" Text="{Loc 'chemistry-trial-categories-all'}" StyleClasses="OpenRight"/>
                <Button Name="NoneButton" Text="{Loc 'chemistry-trial-categories-none'}" StyleClasses="OpenLeft"/>
            </BoxContainer>
            <ScrollContainer VerticalExpand="True" HScrollEnabled="False" Margin="0 4">
                <GridContainer Name="CategoryGrid" Columns="3" HorizontalExpand="True"/>
            </ScrollContainer>

            <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                <Label Name="EligibleLabel" HorizontalExpand="True" StyleClasses="LabelSubText"/>
                <Button Name="StartButton" Text="{Loc 'chemistry-trial-start'}" MinWidth="120"/>
            </BoxContainer>
        </BoxContainer>

        <!-- Time trial -->
        <BoxContainer Name="RunBox" Orientation="Vertical" VerticalExpand="True" Visible="False">
            <BoxContainer Orientation="Horizontal">
                <Label Name="TimeLabel" HorizontalExpand="True" StyleClasses="LabelKeyText"/>
                <Label Name="ScoreLabel"/>
            </BoxContainer>

            <Label Name="PromptLabel" Margin="0 12 0 4" StyleClasses="LabelSubText"/>
            <RichTextLabel Name="QuestionLabel" Margin="0 0 0 12"/>

            <Label Name="AmountsLabel"/>
            <LineEdit Name="AmountsEdit" Margin="0 2 0 8"/>

            <BoxContainer Name="TemperatureBox" Orientation="Vertical">
                <Label Text="{Loc 'chemistry-trial-temperature'}"/>
                <LineEdit Name="TemperatureEdit" Margin="0 2 0 8"
                          PlaceHolder="{Loc 'chemistry-trial-temperature-placeholder'}"/>
            </BoxContainer>

            <BoxContainer Orientation="Horizontal">
                <Button Name="AbortButton" Text="{Loc 'chemistry-trial-abort'}" StyleClasses="Caution"/>
                <Control HorizontalExpand="True"/>
                <Button Name="SubmitButton" Text="{Loc 'chemistry-trial-submit'}" MinWidth="120"/>
            </BoxContainer>

            <PanelContainer Name="RevealPanel" Margin="0 12 0 0" Visible="False" StyleClasses="BackgroundDark">
                <BoxContainer Orientation="Vertical" Margin="8">
                    <Label Name="RevealTitle" FontColorOverride="#e05050"/>
                    <RichTextLabel Name="RevealLabel" Margin="0 4"/>
                    <Label Name="RevealCountdown" StyleClasses="LabelSubText"/>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>

        <!-- Results -->
        <BoxContainer Name="ResultsBox" Orientation="Vertical" VerticalExpand="True" Visible="False">
            <Label Text="{Loc 'chemistry-trial-results'}" StyleClasses="LabelHeading" HorizontalAlignment="Center"/>
            <Control VerticalExpand="True"/>
            <Label Name="PassedLabel" HorizontalAlignment="Center" FontColorOverride="#50c050"/>
            <Label Name="FailedLabel" HorizontalAlignment="Center" FontColorOverride="#e05050"/>
            <Label Name="TotalLabel" HorizontalAlignment="Center"/>
            <Control VerticalExpand="True"/>
            <Button Name="DismissButton" Text="{Loc 'chemistry-trial-dismiss'}" HorizontalAlignment="Center" MinWidth="120"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
